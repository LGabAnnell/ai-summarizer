{
  "name": "article-summarizer",
  "version": "1.0.0",
  "description": "Firefox Manifest V3 extension that extracts article content and sends it to configurable AI providers for summarization",
  "main": "extension-core/background.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:shared && npm run build:popup && npm run build:options && npm run build:sidebar && npm run build:extension",
    "build:debug": "npm run build:shared:debug && npm run build:popup:debug && npm run build:options:debug && npm run build:sidebar:debug && npm run build:extension",
    "build:popup": "ng build popup --configuration production",
    "build:popup:debug": "ng build popup --configuration debug",
    "build:options": "ng build options --configuration production",
    "build:options:debug": "ng build options --configuration debug",
    "build:sidebar": "ng build sidebar --configuration production",
    "build:sidebar:debug": "ng build sidebar --configuration debug",
    "build:shared": "ng build shared",
    "build:shared:debug": "ng build shared --configuration debug",
    "build:extension": "npx tsx builds/build-extension.ts && npx tsx builds/package-dist.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "package": "web-ext build",
    "run": "web-ext run"
  },
  "private": true,
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "webextension-polyfill": "^0.12.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/animations": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.0.0",
    "@types/webextension-polyfill": "^0.12.5",
    "esbuild": "^0.28.1",
    "marked": "^18.0.7",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.0",
    "web-ext": "^10.5.0"
  }
}
