{
  "manifest_version": 3,
  "name": "AI Article Summarizer",
  "version": "1.0.1",
  "description": "Extracts article content and summarizes it using configurable AI providers (Mistral, OpenAI, Anthropic, Qwen, DeepSeek, Custom). Includes local text classification using Firefox's built-in AI runtime.",
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    }
  },
  "sidebar_action": {
    "default_panel": "sidebar/index.html",
    "default_title": "Article Summarizer",
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    },
    "open_at_install": false
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Alt+F",
        "mac": "MacCtrl+Shift+F"
      },
      "description": "Toggle the sidebar"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "trialML"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-summarizer@annell.ch",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
