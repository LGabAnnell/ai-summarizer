              },
              "fonts": true
            },
            "outputHashing": "none",
            "sourceMap": false,
            "namedChunks": false,
            "extractLicenses": false,
            "fileReplacements": [
              {
                "replace": "projects/options/src/environments/environment.ts",
                "with": "projects/options/src/environments/environment.prod.ts"
              }
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "none"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
